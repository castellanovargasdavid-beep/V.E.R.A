# === IA (Anthropic Claude vía Vercel AI SDK) ===
# Requerida para respuestas reales de V.E.R.A. Si se omite, la app funciona
# en modo simulación (mock) con respuestas y streaming de ejemplo.
ANTHROPIC_API_KEY=

# === Supabase (Auth + PostgreSQL) ===
# Si se omiten, la app usa datos simulados y el modo demo sin login real.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (panel de Supabase → Settings → API). Solo la usan los
# webhooks de integraciones móviles, server-to-server, para leer/escribir
# vínculos de cuenta sin sesión de usuario. NUNCA la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# === Integraciones móviles: Telegram (opcional) ===
# Crea un bot con @BotFather, copia su token y su @username, y registra el
# webhook con: https://api.telegram.org/bot<TOKEN>/setWebhook?url=<tu-dominio>/api/integrations/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secreto propio (cualquier cadena larga aleatoria) que Telegram reenvía en
# cada petición al webhook para poder verificar que viene de verdad de Telegram.
TELEGRAM_WEBHOOK_SECRET=

# === Integraciones móviles: WhatsApp (opcional, Meta Cloud API) ===
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número de WhatsApp Business en formato internacional sin "+" (p.ej. 34600111222), para el deep-link wa.me.
WHATSAPP_BUSINESS_NUMBER=
# App Secret de tu app de Meta — se usa para verificar la firma HMAC de cada webhook entrante.
WHATSAPP_APP_SECRET=
# El mismo valor que pongas al registrar el webhook en Meta (handshake de verificación).
WHATSAPP_VERIFY_TOKEN=

# === OpenAI (opcional) ===
# La misma clave alimenta dos cosas independientes: la transcripción de
# notas de voz de WhatsApp/Telegram (Whisper) y la Opción B del motor de
# voz de V.E.R.A. (lib/tts.ts) cuando ElevenLabs no está configurado.
OPENAI_API_KEY=
# Voz de OpenAI TTS — "onyx" es la más grave y serena del catálogo, la más
# cercana al perfil de mayordomo calmado. Alternativas: alloy, echo, fable,
# nova, shimmer.
OPENAI_TTS_VOICE=onyx
# "tts-1" prioriza latencia; "tts-1-hd" prioriza calidad si no te importa
# esperar un poco más por respuesta.
OPENAI_TTS_MODEL=tts-1

# === Voz natural — Opción A del motor de voz (opcional, ElevenLabs) ===
# Motor de síntesis modular (lib/tts.ts): si esta clave está configurada,
# V.E.R.A. siempre la usa primero (calidad de estudio) antes que OpenAI TTS
# o la voz nativa del navegador. Tiene coste por carácter sintetizado en tu
# cuenta de ElevenLabs — revisa https://elevenlabs.io/pricing.
ELEVENLABS_API_KEY=
# ID de voz de https://elevenlabs.io/app/voice-library. Por defecto se usa
# "George" (timbre británico, cálido y contenido — el más cercano de las
# voces premade al perfil de mayordomo de ingeniería que pide V.E.R.A.).
# Cambia este ID por el de tu propio voice clone si tienes uno.
ELEVENLABS_VOICE_ID=
# "eleven_multilingual_v2" (calidad máxima) o "eleven_turbo_v2_5" (más
# rápido y barato, calidad algo menor).
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
