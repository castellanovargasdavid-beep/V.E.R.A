# === IA (Anthropic Claude vía Vercel AI SDK) ===
# Requerida para respuestas reales de V.E.R.A. Si se omite, la app funciona
# en modo simulación (mock) con respuestas y streaming de ejemplo.
ANTHROPIC_API_KEY=

# === Supabase (Auth + PostgreSQL) ===
# Si se omiten, la app usa datos simulados y el modo demo sin login real.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (panel de Supabase → Settings → API). Solo la usan los
# webhooks de integraciones móviles, server-to-server, para leer/escribir
# vínculos de cuenta sin sesión de usuario. NUNCA la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# === Integraciones móviles: Telegram (opcional) ===
# Crea un bot con @BotFather, copia su token y su @username, y registra el
# webhook con: https://api.telegram.org/bot<TOKEN>/setWebhook?url=<tu-dominio>/api/integrations/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Secreto propio (cualquier cadena larga aleatoria) que Telegram reenvía en
# cada petición al webhook para poder verificar que viene de verdad de Telegram.
TELEGRAM_WEBHOOK_SECRET=

# === Integraciones móviles: WhatsApp (opcional, Meta Cloud API) ===
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número de WhatsApp Business en formato internacional sin "+" (p.ej. 34600111222), para el deep-link wa.me.
WHATSAPP_BUSINESS_NUMBER=
# App Secret de tu app de Meta — se usa para verificar la firma HMAC de cada webhook entrante.
WHATSAPP_APP_SECRET=
# El mismo valor que pongas al registrar el webhook en Meta (handshake de verificación).
WHATSAPP_VERIFY_TOKEN=

# === Transcripción de notas de voz (opcional, OpenAI Whisper) ===
# Sin esta clave, las notas de voz recibidas por WhatsApp/Telegram no se
# pueden transcribir — V.E.R.A responde pidiendo el mensaje en texto.
OPENAI_API_KEY=

# === Voz natural (opcional, ElevenLabs) ===
# Si se omite, el Modo Voz usa la síntesis de voz nativa del navegador
# (gratis, algo más robótica). Con esta clave, V.E.R.A responde con una voz
# neuronal cálida y natural. Tiene coste por carácter sintetizado en tu
# cuenta de ElevenLabs — revisa https://elevenlabs.io/pricing.
ELEVENLABS_API_KEY=
# ID de voz de https://elevenlabs.io/app/voice-library (elige una en
# español para el mejor resultado). Si se omite, se usa una voz por defecto.
ELEVENLABS_VOICE_ID=
